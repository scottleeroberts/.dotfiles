#!/usr/bin/env bash

NERD_DIR="${HOME}/.local/share/nerd-dictation/nerd-dictation"
STATE_FILE="/tmp/nerd-dictation.state"

# Check if already running
if [[ -f "${STATE_FILE}" ]]; then
    exit 0
fi

# Start nerd-dictation (default: types directly into focused window)
cd "${NERD_DIR}"
source .venv/bin/activate
nohup ./nerd-dictation begin --vosk-model-dir=./model 2>&1 &

# Create state file
echo "recording" > "${STATE_FILE}"

# Refresh i3blocks
pkill -RTMIN+10 i3blocks
