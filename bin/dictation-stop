#!/usr/bin/env bash

NERD_DIR="${HOME}/.local/share/nerd-dictation/nerd-dictation"
STATE_FILE="/tmp/nerd-dictation.state"

# Check if running
if [[ ! -f "${STATE_FILE}" ]]; then
    exit 0
fi

# Show processing state
echo "processing" > "${STATE_FILE}"
pkill -RTMIN+10 i3blocks

# Stop nerd-dictation (it will type the text automatically)
cd "${NERD_DIR}"
source .venv/bin/activate
./nerd-dictation end

# Remove state file
rm -f "${STATE_FILE}"

# Refresh i3blocks
pkill -RTMIN+10 i3blocks
