#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")" && pwd)
desktop=1
check=0
for arg in "$@"; do
  case "$arg" in
    --core) desktop=0 ;;
    --desktop) desktop=1 ;;
    --check) check=1 ;;
    *) echo 'Usage: stow_all [--core|--desktop] [--check]' >&2; exit 2 ;;
  esac
done
modules=(gem git ignore mise neovim readline tmux urlview zsh tmate)
if (( desktop )); then modules+=(alacritty picom dunst fonts i3 rofi xmodmap xprofile); fi
options=(--dir "$root" --target "$HOME")
# A local .stowrc can enable --adopt or override the operation.
stow_home=$(mktemp -d)
trap 'rmdir -- "$stow_home"' EXIT
run_stow() (
  cd "$stow_home"
  HOME="$stow_home" stow "$@" "${options[@]}" "${modules[@]}"
)
if ! run_stow --simulate; then
  echo 'Stow found existing config. Review the conflicts, then back up or merge those files yourself.' >&2
  exit 1
fi
if (( ! check )); then run_stow; fi
